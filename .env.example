# ── BASE DE DATOS ──────────────────────────────────────────
# Conseguís esto en: supabase.com → Settings → Database → Connection string
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres"

# ── SERVIDOR ───────────────────────────────────────────────
PORT=3000
NODE_ENV=development
FRONTEND_URL=https://tuusuario.github.io/nayart
BACKEND_URL=https://tu-app.railway.app

# ── JWT ────────────────────────────────────────────────────
# Generá uno en: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=reemplaza_con_string_aleatorio_largo_y_seguro

# ── CLOUDINARY ─────────────────────────────────────────────
# Conseguís esto en: cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# ── MERCADOPAGO ────────────────────────────────────────────
# Conseguís esto en: mercadopago.com.ar → Desarrolladores → Credenciales
MP_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── STRIPE ─────────────────────────────────────────────────
# Conseguís esto en: dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── EMAIL ──────────────────────────────────────────────────
# Conseguís esto en: resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_ADMIN=santiornaghi@gmail.com
